# Binance Thailand (required for live / data)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.th

# Live trading gate (engine checks this in addition to bot_config.yaml)
LIVE_TRADING=false
SIMULATE_ONLY=true
BOT_READ_ONLY=false

# Optional: force a single pair (overrides focus; whitelist still applies)
# DEFAULT_SYMBOL=XAUUSDT
# XAUBY_FOCUS_SYMBOL=XAUUSDT

# Telegram alerts + command polling
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional WebSocket override (see bot_config.yaml header)
# BINANCE_WS_URL=wss://www.binance.th/gstream

# Cross-instance live-account lock directory. Default is ~/.xauby/account_locks,
# which only guards engines run by the SAME user. If this host also runs
# systemd tenant engines (xauby-engine@.service sets
# XAUBY_ACCOUNT_LOCK_DIR=/var/lib/xauby/account_locks), point this at the SAME
# directory — otherwise two live engines on one exchange account cannot see
# each other's lock and will silently double-trade the account.
# XAUBY_ACCOUNT_LOCK_DIR=/var/lib/xauby/account_locks
