{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://xauby-vps.tailfcdd3a.ts.net/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://xauby-vps.tailfcdd3a.ts.net/auth/:path*" },
    { "source": "/healthz", "destination": "https://xauby-vps.tailfcdd3a.ts.net/healthz" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/auth/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
