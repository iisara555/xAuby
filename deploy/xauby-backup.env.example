# Optional P2.2 off-site backup configuration.  Copy to /etc/xauby/backup.env
# as root:xauby-control mode 0640; never commit the deployed file.
#
# The backup service refuses off-site upload unless all three controls below
# are set: an AES backup key, a dedicated rclone destination, and the GPG
# public-key recipient for the recovery bundle.

# Generate without printing the key:
#   sudo /opt/xauby/current/venv/bin/python scripts/ensure_backup_encryption_key.py
XAUBY_BACKUP_ENCRYPTION_KEY=

# An rclone *directory*, dedicated to xAuby backups; e.g.
# XAUBY_BACKUP_RCLONE_DESTINATION=xauby-crypt:production/saas
XAUBY_BACKUP_RCLONE_DESTINATION=
XAUBY_BACKUP_RCLONE_CONFIG=/etc/xauby/rclone.conf
XAUBY_BACKUP_OFFSITE_RETENTION_DAYS=30

# Import only the offline recovery public key into this homedir, then set the
# recipient fingerprint.  The matching private key must remain off this VPS.
XAUBY_BACKUP_GPG_HOMEDIR=/var/lib/xauby/backup-gpg
XAUBY_BACKUP_GPG_RECIPIENT=
