#!/usr/bin/env bash
set -euo pipefail

tenant="${1:-}"
if [[ ! "$tenant" =~ ^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$ ]]; then
  echo "invalid tenant slug" >&2
  exit 2
fi

exec /opt/xauby/current/venv/bin/python - "$tenant" <<'PY'
import sys

from xauby.saas.credentials import CredentialCipher
from xauby.saas.settings import SaaSSettings
from xauby.saas.store import ControlPlaneStore
from xauby.saas.supervisor import TenantSupervisor, attach_tenant_loaders

tenant_slug = sys.argv[1]
settings = SaaSSettings.from_env("/opt/xauby/current")
store = ControlPlaneStore(settings.database_path)
store.migrate()
cipher = CredentialCipher(settings.credential_master_key)

supervisor = TenantSupervisor(settings)
# Both loaders, from the one place that defines them. Wiring only the exchange
# loader here left `_telegram_env_lines` with nothing to call, so every systemd
# start rewrote the env file with TELEGRAM_ENABLED="false" and per-tenant alerts
# died on every reboot.
attach_tenant_loaders(supervisor, store, cipher)

path = supervisor.materialize_credentials(tenant_slug)
if path is None:
    # Not an error. A tenant with no exchange keys and no Telegram connection is
    # a brand-new SIM-only account — the default state of every new user — and
    # exiting non-zero here failed ExecStartPre, so their engine could never
    # start. The unit declares EnvironmentFile with a leading '-', so a missing
    # file is tolerated and the engine falls back to simulation, which is the
    # correct behaviour for a tenant who has connected nothing.
    print(f"No credentials to materialize for {tenant_slug}; starting without them")
    sys.exit(0)
print(f"Materialized encrypted credentials for {tenant_slug}")
PY
