#!/usr/bin/env bash
set -euo pipefail

tenant="${1:-}"
if [[ ! "$tenant" =~ ^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$ ]]; then
  echo "invalid tenant slug" >&2
  exit 2
fi

exec /opt/xauby/current/venv/bin/python - "$tenant" <<'PY'
import sys

from xauby.saas.credentials import CredentialCipher
from xauby.saas.settings import SaaSSettings
from xauby.saas.store import ControlPlaneStore
from xauby.saas.supervisor import TenantSupervisor

tenant_slug = sys.argv[1]
settings = SaaSSettings.from_env("/opt/xauby/current")
store = ControlPlaneStore(settings.database_path)
store.migrate()
cipher = CredentialCipher(settings.credential_master_key)

def load_credentials(slug: str):
    tenant = store.tenant_by_slug(slug)
    if not tenant:
        return None
    encrypted = store.encrypted_credentials(tenant["id"])
    if not encrypted:
        return None
    target_id, envelope = encrypted
    return target_id, cipher.decrypt(tenant["id"], target_id, envelope)

supervisor = TenantSupervisor(settings)
supervisor.set_credential_loader(load_credentials)
path = supervisor.materialize_credentials(tenant_slug)
if path is None:
    raise SystemExit("encrypted tenant credentials are unavailable")
print(f"Materialized encrypted credentials for {tenant_slug}")
PY
