#!/usr/bin/env bash
set -euo pipefail

action="${1:-}"
tenant="${2:-}"
if [[ ! "$action" =~ ^(start|stop|restart|is-active)$ ]]; then
  echo "invalid service action" >&2
  exit 2
fi
if [[ ! "$tenant" =~ ^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$ ]]; then
  echo "invalid tenant slug" >&2
  exit 2
fi
exec /usr/bin/systemctl "$action" "xauby-engine@${tenant}.service"
