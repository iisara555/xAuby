#!/usr/bin/env bash
set -euo pipefail

action="${1:-}"
tenant="${2:-}"
if [[ ! "$action" =~ ^(start|stop|restart|is-active)$ ]]; then
  echo "invalid service action" >&2
  exit 2
fi
if [[ ! "$tenant" =~ ^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$ ]]; then
  echo "invalid tenant slug" >&2
  exit 2
fi

engine_unit="xauby-engine@${tenant}.service"
deadman_unit="xauby-deadman@${tenant}.timer"

case "$action" in
  start)
    /usr/bin/systemctl start "$engine_unit"
    /usr/bin/systemctl enable --now "$deadman_unit"
    ;;
  restart)
    /usr/bin/systemctl restart "$engine_unit"
    /usr/bin/systemctl enable --now "$deadman_unit"
    ;;
  stop)
    /usr/bin/systemctl stop "$engine_unit"
    /usr/bin/systemctl disable --now "$deadman_unit"
    ;;
  is-active)
    exec /usr/bin/systemctl is-active "$engine_unit"
    ;;
esac
