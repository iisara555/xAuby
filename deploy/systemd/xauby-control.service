[Unit]
Description=xAuby SaaS Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xauby-control
Group=xauby-control
WorkingDirectory=/opt/xauby/current
EnvironmentFile=/etc/xauby/control.env
ExecStart=/opt/xauby/current/venv/bin/python -m xauby.saas --host 127.0.0.1 --port 8790
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xauby/control /var/lib/xauby/runtime /etc/xauby/tenants
# argon2 allocates 64 MiB per password/PIN hash (bounded to 2 concurrent in
# xauby/saas/security.py) and the chart endpoint pulls pandas into the process
# on first use. 280M left no room for either and made a handful of parallel
# logins an OOM kill of the whole control plane.
MemoryHigh=340M
MemoryMax=420M
CPUQuota=25%
TasksMax=96
UMask=0077
RuntimeDirectory=xauby/credentials
RuntimeDirectoryMode=0700

[Install]
WantedBy=multi-user.target
