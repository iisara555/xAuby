[Unit]
Description=xAuby research-only shadow evaluator (%i)
After=xauby-control.service
ConditionPathExists=/var/lib/xauby/runtime/%i/shadow

[Service]
Type=oneshot
User=xsh-%i
Group=xsh-%i
WorkingDirectory=/opt/xauby/current
RuntimeDirectory=xauby-shadow/%i
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin PYTHONPATH=/opt/xauby/current /opt/xauby/current/venv/bin/python -m xauby.shadow_evaluator --tenant %i --runtime-root /run/xauby-shadow
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
InaccessiblePaths=/var/lib/xauby/runtime /etc/xauby /var/lib/xauby/control /var/lib/xauby/backups -/var/lib/xauby/backup-gpg /var/lib/xauby/account_locks /run/xauby/credentials
InaccessiblePaths=-/opt/xauby/current/.env -/opt/xauby/current/core
BindReadOnlyPaths=/var/lib/xauby/runtime/%i:/run/xauby-shadow/%i
BindPaths=/var/lib/xauby/runtime/%i/shadow:/run/xauby-shadow/%i/shadow
MemoryHigh=260M
MemoryMax=340M
CPUQuota=15%
TasksMax=64
UMask=0007
TimeoutStartSec=90
