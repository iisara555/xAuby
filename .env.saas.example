# xAuby SaaS control-plane environment.
#
# Loaded by systemd (deploy/systemd/xauby-control.service: EnvironmentFile=
# /etc/xauby/control.env) — NOT read from the repo directly. scripts/
# install_saas_host.sh copies this file to /etc/xauby/control.env on first
# install, substituting the install path and generating both secrets below;
# it will not overwrite an existing control.env, so re-running the installer
# is safe. Keep the deployed copy at 0640 root:xauby-control (the installer
# sets this for you).
#
# This file documents every XAUBY_* variable SaaSSettings.from_env() reads
# (xauby/saas/settings.py). Values left blank use the default noted in the
# comment.

# --- Paths -------------------------------------------------------------------
# Project checkout the control plane runs from. install_saas_host.sh replaces
# this literal path with $XAUBY_INSTALL_ROOT (default /opt/xauby/current).
XAUBY_PROJECT_ROOT=/opt/xauby/current
# Where tenant configs, runtime state and the control-plane DB live.
# Default: <XAUBY_PROJECT_ROOT>/saas-data
# XAUBY_SAAS_DATA_ROOT=
# Default: <data_root>/tenants
# XAUBY_TENANT_CONFIG_ROOT=
# Default: <data_root>/runtime
# XAUBY_TENANT_RUNTIME_ROOT=
# Default: <data_root>/control-plane.db
# XAUBY_SAAS_DB=
# Decrypted exchange credentials are materialized here for the engine to
# read (tmpfs-backed; never persisted to disk).
XAUBY_CREDENTIAL_RUNTIME_ROOT=/run/xauby/credentials

# --- Secrets (required in production; dev-login mode can skip both) ----------
# Signs session cookies and short-lived OAuth state. install_saas_host.sh
# generates this with: openssl rand -hex 32
XAUBY_SAAS_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Encrypts stored exchange API keys/secrets at rest. Must base64-decode to
# exactly 32 bytes. install_saas_host.sh generates this with:
#   openssl rand -base64 32
# Treat it like a database master key: back it up somewhere safe and never
# commit it. *Losing* it invalidates every stored exchange connection — every
# user has to re-enter their API keys. *Rotating* it does not: see below.
XAUBY_CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-random-bytes

# --- Master key rotation (P2.2) ------------------------------------------------
# Leave both unset for a single-key deployment; the defaults below are exactly
# what one key behaves like today. `scripts/rotate_credential_key.py` writes
# them for you — its docstring is the four-step runbook, and it is the only
# supported way to rotate, because it verifies each re-encrypted envelope
# before overwriting the only copy of a tenant's credentials.
#
# The id of the key above. Stamped into every envelope written from now on.
XAUBY_CREDENTIAL_MASTER_KEY_ID=1
# Previous keys, decrypt-only, as <id>:<base64>,<id>:<base64>. They exist so
# credentials stored under an older key stay readable until they have been
# re-encrypted. Do not remove an entry by hand — run
# `rotate_credential_key.py --retire-complete`, which refuses while anything
# still depends on it.
#XAUBY_CREDENTIAL_RETIRED_KEYS=

# --- Off-host backup (P2.2) ----------------------------------------------------
# Without these, the encrypted database, the master key and every backup sit on
# one VPS: losing the host loses every tenant's exchange connection permanently.
# xauby-backup.service uploads each verified backup here and FAILS if it cannot,
# including when these are unset — a backup task that silently does nothing is
# not a backup.
#
# Any S3-compatible endpoint (Backblaze B2, Cloudflare R2, AWS S3).
XAUBY_BACKUP_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
XAUBY_BACKUP_S3_BUCKET=xauby-backups
XAUBY_BACKUP_S3_REGION=us-west-004
# Use a WRITE-ONLY application key if the provider offers one. The uploader has
# no delete verb on purpose, so a compromised host cannot erase its own backups;
# a write-only key means it cannot read them back either.
XAUBY_BACKUP_S3_ACCESS_KEY_ID=
XAUBY_BACKUP_S3_SECRET_ACCESS_KEY=
XAUBY_BACKUP_S3_PREFIX=control-plane
#
# The master key is deliberately NOT uploaded, and both the backup builder and
# the uploader refuse an archive that carries it. Keep it offline yourself
# (password manager / paper). The trade-off is explicit: an attacker who takes
# the bucket gets ciphertext they cannot open — and if you lose the offline key,
# the backups cannot be decrypted by anyone, including you.
#
# Set retention with the provider's lifecycle rules, not on this host.

# --- Public identity -----------------------------------------------------------
# Externally reachable base URL (used to build OAuth redirect / invite links).
XAUBY_PUBLIC_BASE_URL=https://your-domain.example
# Bootstrap Owner account email (case-insensitive). Default shown.
XAUBY_OWNER_EMAIL=owner@example.com

# --- Capacity ------------------------------------------------------------------
XAUBY_MAX_USERS=3
XAUBY_MAX_ACTIVE_ENGINES=2

# --- Google OAuth sign-in -------------------------------------------------------
XAUBY_GOOGLE_CLIENT_ID=
XAUBY_GOOGLE_CLIENT_SECRET=

# --- SMTP (invite / password-reset emails) --------------------------------------
XAUBY_SMTP_HOST=
XAUBY_SMTP_PORT=587
XAUBY_SMTP_USERNAME=
XAUBY_SMTP_PASSWORD=
# REQUIRED unless XAUBY_SMTP_USERNAME is itself an email address. Several
# providers use an opaque token as the username (SendGrid's is the literal
# `apikey`), and falling back to it produces an invalid From header.
XAUBY_SMTP_FROM=
# Implicit TLS. Port 465 is detected automatically; set this only for a
# provider that uses implicit TLS on a non-standard port.
#XAUBY_SMTP_USE_SSL=0
#
# Verify before inviting anyone: `python -m scripts.check_email --to you@...`.
# Without it, the first sign that email is broken is a design partner telling
# you the invite never arrived.

# --- Feature gates (both default OFF) -------------------------------------------
# Flip only after the corresponding legal/ops review for this deployment.
XAUBY_LIVE_ACTIVATION_ENABLED=false
XAUBY_MANUAL_TRADING_ENABLED=false

# --- Exchange API key IP allowlist ----------------------------------------------
# Comma-separated static egress IP(s) of THIS host. Shown verbatim in
# Settings > API connection so operators know which IP to add to their
# exchange API key's IP-restriction list (OKX calls this "Link IP address").
# Find this host's egress IP with: curl -s https://ifconfig.me
# Leave empty to show generic "ask your operator" guidance instead.
# Default below is this deployment's production VPS (see deploy/Caddyfile).
XAUBY_API_WHITELIST_IPS=188.166.253.203

# --- Process control (systemd/sudo helpers installed by install_saas_host.sh) --
XAUBY_SYSTEMCTL=systemctl
XAUBY_PROVISION_HELPER=/usr/local/libexec/xauby-provision-tenant
XAUBY_SERVICE_HELPER=/usr/local/libexec/xauby-service-control

# --- Cookies / dev login (leave at these defaults in production) ---------------
# Send session cookies only over HTTPS. Only disable for local HTTP dev.
XAUBY_SAAS_COOKIE_SECURE=1
# Bypasses Google OAuth + the two secrets above for local development only.
# Never enable this on a host reachable from the internet.
XAUBY_SAAS_DEV_LOGIN=false
