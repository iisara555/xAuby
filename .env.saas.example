XAUBY_PROJECT_ROOT=/opt/xauby/current
XAUBY_SAAS_DATA_ROOT=/var/lib/xauby/control
XAUBY_TENANT_CONFIG_ROOT=/etc/xauby/tenants
XAUBY_TENANT_RUNTIME_ROOT=/var/lib/xauby/runtime
XAUBY_SAAS_DB=/var/lib/xauby/control/control-plane.db
XAUBY_PUBLIC_BASE_URL=https://xauby.vercel.app
XAUBY_SAAS_SESSION_SECRET=replace-with-at-least-32-random-bytes
XAUBY_GOOGLE_CLIENT_ID=replace.apps.googleusercontent.com
XAUBY_GOOGLE_CLIENT_SECRET=replace
XAUBY_OWNER_EMAIL=iisara555@gmail.com
XAUBY_MAX_USERS=3
XAUBY_MAX_ACTIVE_ENGINES=2
XAUBY_SMTP_HOST=smtp.gmail.com
XAUBY_SMTP_PORT=587
XAUBY_SMTP_USERNAME=iisara555@gmail.com
XAUBY_SMTP_PASSWORD=replace-with-google-app-password
XAUBY_SMTP_FROM=xAuby Pilot <iisara555@gmail.com>
XAUBY_LIVE_ACTIVATION_ENABLED=0

# Temporary read-only bridge for the owner's existing legacy engine.
# Keep the WebUI URL and bearer token on the VPS only; never expose them to Vercel.
XAUBY_LEGACY_OWNER_SLUG=
XAUBY_LEGACY_WEBUI_URL=
XAUBY_LEGACY_WEBUI_TOKEN=
XAUBY_LEGACY_WEBUI_TIMEOUT=3
XAUBY_SAAS_COOKIE_SECURE=1
XAUBY_PROVISION_HELPER=/usr/local/libexec/xauby-provision-tenant
XAUBY_SERVICE_HELPER=/usr/local/libexec/xauby-service-control
